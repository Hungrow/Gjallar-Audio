<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <!-- Permite consultar intents para explorar carpetas y archivos -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="resource/folder" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>

        <!-- Gestores de archivos conocidos populares para visibilidad en Android 11+ -->
        <package android:name="pl.solidexplorer2" />
        <package android:name="pl.solidexplorer" />
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.mi.android.globalFileexplorer" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.cxinventor.file.explorer" />
        <package android:name="com.alphainventor.filemanager" />
        <package android:name="com.ghisler.android.TotalCommander" />
        <package android:name="nextapp.fx" />
        <package android:name="com.amaze.filemanager" />
        <package android:name="me.zhanghai.android.files" />

        <!-- Apps de música y streaming para detección y retorno rápido -->
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.amazon.mp3" />
        <package android:name="com.audible.application" />
        <package android:name="com.ivoox.app" />
        <package android:name="deezer.android.app" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.soundcloud.android" />
        <package android:name="au.com.shiftyjelly.pocketcasts" />
        <package android:name="com.podbean.app.podcast" />
        <package android:name="tunein.player" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GjallarAudio">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GjallarAudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".feature.night.SleepTimerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".feature.night.MediaNotificationListener"
            android:label="Control de Streaming Gjallar"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
